{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://43.204.235.124:5000/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "http://43.204.235.124:5000/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
